# Both Supabase values are required; the app stops at startup without them.
# Android emulator: http://10.0.2.2:54321 | physical device: http://<your-LAN-IP>:54321 | iOS sim / web: http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=
# The anon/publishable key only. Never the service-role key: EXPO_PUBLIC_ values are bundled into the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
